rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read: if true;
    }

    // Contas de Administrador e Lojistas
    match /accounts/{accountId} {
      allow read: if true;
      allow write: if true;
    }

    // Configurações, Cardápio e Pedidos por Loja
    match /stores/{storeId} {
      allow read: if true;
      allow write: if true;

      match /settings/{docId} {
        allow read: if true;
        allow write: if true;
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if true;
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if true;
      }

      match /orders/{orderId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if true;
      }
    }
  }
}
